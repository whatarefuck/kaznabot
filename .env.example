# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# Свой сервер Bot API в режиме --local, если api.telegram.org с сервера недоступен. Обычно не нужен.
# TELEGRAM_API_URL=http://127.0.0.1:8081

# developers.sber.ru → проект GigaChat API → «Ключ авторизации» (Authorization key, base64)
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлица
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Для фото чеков нужна модель с поддержкой изображений. GigaChat-2-Max на личном тарифе бывает очень медленным
GIGACHAT_MODEL=GigaChat-2-Pro
# Сертификат НУЦ Минцифры: https://www.gosuslugi.ru/crt (russian_trusted_root_ca.cer)
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.cer
# Только для локальной отладки, если нет сертификата:
# GIGACHAT_VERIFY_SSL=false

DATABASE_URL=sqlite+aiosqlite:///data/kaznabot.db
# Чекпоинтер LangGraph — черновики, ждущие подтверждения
CHECKPOINT_PATH=data/checkpoints.db
TIMEZONE=Europe/Moscow
# true — бот сам разбирает все фото в чате (не-чеки молча игнорирует);
# false — только фото с подписью /add или @упоминанием бота
AUTO_PARSE_PHOTOS=true

# Мониторинг LangSmith (необязательно): трейсы графа и вызовов GigaChat уходят на smith.langchain.com.
# Библиотека читает эти переменные из окружения процесса, а не из .env: на сервере они заданы в /etc/kaznabot.env.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=kaznabot

# Быт квартиры (время местное, см. TIMEZONE)
# DUTY_REMINDER_TIME=19:00     # суббота: кто дежурит в воскресенье
# DINNER_POLL_TIME=12:00       # суббота: голосование «кто когда готовит ужин»
# DINNER_DEADLINE_TIME=13:00   # понедельник: итог голосования
